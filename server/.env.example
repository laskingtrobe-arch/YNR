# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# ---- Database ---------------------------------------------------------
# A Postgres connection string. Using Supabase: Project Settings ->
# Database -> Connection string -> URI (the "Session" pooler mode, port
# 5432, is right for this app — it keeps a long-lived pool the way this
# server runs, unlike the transaction-mode pooler serverless functions need).
# Required. The server refuses to boot without it once NODE_ENV=production.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
# Set to 0 only for a local Postgres with no TLS. Supabase always needs TLS.
DATABASE_SSL=1

# Where the storefront is served from (used for CORS + redirects)
SITE_URL=http://localhost:3020
API_URL=http://localhost:4000

# How long a one-of-one piece stays reserved during checkout
HOLD_MINUTES=30

WHATSAPP_NUMBER=2349026947815

# ---- Paystack -------------------------------------------------------------
# PAYSTACK_MODE=mock lets you exercise the whole checkout with no real money.
# It is ignored when NODE_ENV=production.
PAYSTACK_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Mail -----------------------------------------------------------------
# With no SMTP_URL, mail is written to the outbox table and logged.
SMTP_URL=
MAIL_FROM=YnR <orders@ynr.local>
OWNER_EMAIL=owner@ynr.local

# Required in production
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ---- Storage ----------------------------------------------------------
# Uploaded product photos live on disk, separate from the database. On a
# host with a mounted volume (see render.yaml), point this at it.
UPLOADS_DIR=
# The storefront folder, served by this server as one app. Leave unset to
# use the sibling ../storefront directory (the normal repo layout).
STOREFRONT_DIR=

# ---- First-boot setup ---------------------------------------------------
# For a host with no shell access. AUTO_SEED=1 loads the starting catalogue
# if the products table is empty. Setting ADMIN_EMAIL + ADMIN_PASSWORD
# creates the first admin account if none exists yet — remove the password
# from the environment again once you have signed in and changed it.
AUTO_SEED=
ADMIN_EMAIL=
ADMIN_PASSWORD=
