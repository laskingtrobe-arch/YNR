# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Where the storefront is served from (used for CORS + redirects)
SITE_URL=http://localhost:3020
API_URL=http://localhost:4000

# How long a one-of-one piece stays reserved during checkout
HOLD_MINUTES=30

WHATSAPP_NUMBER=2349026947815

# ---- Paystack -------------------------------------------------------------
# PAYSTACK_MODE=mock lets you exercise the whole checkout with no real money.
# It is ignored when NODE_ENV=production.
PAYSTACK_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Mail -----------------------------------------------------------------
# With no SMTP_URL, mail is written to the outbox table and logged.
SMTP_URL=
MAIL_FROM=YnR <orders@ynr.local>
OWNER_EMAIL=owner@ynr.local

# Required in production
SESSION_SECRET=
SESSION_TTL_HOURS=12
