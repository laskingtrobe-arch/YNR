{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "storefront",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ynr-shop.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://ynr-shop.onrender.com/uploads/:path*" },
    { "source": "/admin/:path*", "destination": "https://ynr-shop.onrender.com/admin/:path*" },
    { "source": "/admin", "destination": "https://ynr-shop.onrender.com/admin" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
